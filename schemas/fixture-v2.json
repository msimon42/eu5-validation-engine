{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eu5-mod-engine:fixture:2",
  "title": "Immutable fixture manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "tier",
    "profile",
    "inputs",
    "playset",
    "baselines",
    "expected"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "contract",
        "conformance"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "revision",
        "production_export_enabled"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "game_id": {
          "const": "eu5"
        },
        "target_platform": {
          "const": "windows"
        },
        "kind": {
          "enum": [
            "synthetic",
            "documentation_only",
            "conformed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bare_registration": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode_order": {
          "type": "array",
          "items": {
            "enum": [
              "INJECT_OR_CREATE",
              "REPLACE_OR_CREATE",
              "TRY_INJECT",
              "TRY_REPLACE",
              "INJECT",
              "REPLACE"
            ]
          }
        },
        "production_export_enabled": {
          "const": false
        },
        "conformed_rules": {
          "type": "array"
        },
        "evidence_label": {
          "enum": [
            "P",
            "D",
            "C",
            "I",
            "H",
            "V"
          ]
        },
        "readers": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "scalar_last",
              "scalar_first",
              "numeric_sum",
              "ordered_commands",
              "append_occurrences",
              "named_members",
              "map",
              "single_block_only",
              "unknown"
            ]
          }
        },
        "reference_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "independent_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "target": {
          "type": [
            "object",
            "null"
          ]
        },
        "localization": {
          "type": "object"
        },
        "gui": {
          "type": "object"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "path",
          "bytes_base64",
          "sha256"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes_base64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "playset": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "baselines": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_hash",
          "author_base_hashes"
        ],
        "properties": {
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "author_base_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "build_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exe_sha256",
        "content_sha256",
        "dlc_sha256",
        "docs_sha256"
      ],
      "properties": {
        "exe_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dlc_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "docs_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "finding_kinds",
        "assertions"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "no_repair_needed",
            "blocked_unknown",
            "blocked_design",
            "invalid_input",
            "repair_expected"
          ]
        },
        "finding_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effective": {
          "type": "object"
        },
        "effective_before_patch": {
          "type": "object"
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patch": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "path",
              "bytes_base64",
              "sha256"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes_base64": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "path",
          "bytes_base64",
          "sha256"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes_base64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "agent_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "expected"
      ],
      "properties": {
        "proposal": {
          "type": "object"
        },
        "expected": {
          "enum": [
            "reject",
            "accept_staging"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tier": {
            "const": "conformance"
          }
        }
      },
      "then": {
        "required": [
          "build_fingerprint"
        ]
      }
    }
  ]
}
