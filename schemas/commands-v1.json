{
  "schema_version": 1,
  "envelope": {
    "additionalProperties": false,
    "properties": {
      "command": {
        "enum": [
          "create_workspace",
          "discover_ck3",
          "import_ck3",
          "scan",
          "stage",
          "decision",
          "validate",
          "export",
          "rollback",
          "investigate",
          "cancel",
          "backup",
          "runtime_probe",
          "configure_inference",
          "agent_index",
          "agent_prepare",
          "agent_apply",
          "agent_test",
          "agent_undo",
          "agent_check"
        ],
        "title": "Command",
        "type": "string"
      },
      "workspace_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Workspace Id"
      },
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      },
      "idempotency_key": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Idempotency Key",
        "type": "string"
      },
      "expected_revision": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Revision"
      }
    },
    "required": [
      "command",
      "idempotency_key"
    ],
    "title": "Command",
    "type": "object"
  },
  "payloads": {
    "agent_index": {
      "additionalProperties": false,
      "properties": {
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        }
      },
      "required": [
        "scan_id"
      ],
      "title": "AgentIndex",
      "type": "object"
    },
    "agent_prepare": {
      "additionalProperties": false,
      "properties": {
        "index_id": {
          "title": "Index Id",
          "type": "string"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "combined_base64": {
          "anyOf": [
            {
              "maxLength": 180000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Combined Base64"
        }
      },
      "required": [
        "index_id",
        "issue_id"
      ],
      "title": "AgentPrepare",
      "type": "object"
    },
    "agent_check": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "title": "Context Id",
          "type": "string"
        }
      },
      "required": [
        "context_id"
      ],
      "title": "AgentCheck",
      "type": "object"
    },
    "agent_apply": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        }
      },
      "required": [
        "proposal_id"
      ],
      "title": "AgentProposal",
      "type": "object"
    },
    "agent_test": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        }
      },
      "required": [
        "proposal_id"
      ],
      "title": "AgentProposal",
      "type": "object"
    },
    "agent_undo": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        }
      },
      "required": [
        "proposal_id"
      ],
      "title": "AgentProposal",
      "type": "object"
    },
    "discover_ck3": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "anyOf": [
            {
              "enum": [
                "macos",
                "windows"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "steam_roots": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steam Roots"
        },
        "user_data_path": {
          "anyOf": [
            {
              "maxLength": 32760,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Data Path"
        },
        "installation_path": {
          "anyOf": [
            {
              "maxLength": 32760,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installation Path"
        },
        "playset_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playset Id"
        },
        "root_overrides": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 1000,
          "title": "Root Overrides",
          "type": "object"
        }
      },
      "title": "DiscoverCK3",
      "type": "object"
    },
    "import_ck3": {
      "additionalProperties": false,
      "properties": {
        "discovery_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Discovery Id",
          "type": "string"
        }
      },
      "required": [
        "discovery_id"
      ],
      "title": "ImportCK3",
      "type": "object"
    },
    "create_workspace": {
      "$defs": {
        "Source": {
          "additionalProperties": false,
          "properties": {
            "owner": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Owner",
              "type": "string"
            },
            "path": {
              "maxLength": 32760,
              "minLength": 1,
              "title": "Path",
              "type": "string"
            }
          },
          "required": [
            "owner",
            "path"
          ],
          "title": "Source",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "New workspace",
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "mode": {
          "default": "synthetic",
          "enum": [
            "synthetic",
            "game"
          ],
          "title": "Mode",
          "type": "string"
        },
        "game_id": {
          "default": "eu5",
          "enum": [
            "eu5",
            "ck3"
          ],
          "title": "Game Id",
          "type": "string"
        },
        "target_platform": {
          "anyOf": [
            {
              "enum": [
                "macos",
                "windows"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Platform"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 1000,
          "title": "Sources",
          "type": "array"
        },
        "fixture_path": {
          "anyOf": [
            {
              "maxLength": 32760,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Path"
        }
      },
      "title": "CreateWorkspace",
      "type": "object"
    },
    "scan": {
      "$defs": {
        "Input": {
          "additionalProperties": false,
          "properties": {
            "owner": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Owner",
              "type": "string"
            },
            "path": {
              "maxLength": 32760,
              "minLength": 1,
              "title": "Path",
              "type": "string"
            },
            "bytes_base64": {
              "maxLength": 90000000,
              "title": "Bytes Base64",
              "type": "string"
            }
          },
          "required": [
            "owner",
            "path",
            "bytes_base64"
          ],
          "title": "Input",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "fixture_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Id"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Input"
          },
          "maxItems": 50000,
          "title": "Inputs",
          "type": "array"
        },
        "playset": {
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Playset",
          "type": "array"
        },
        "baselines": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baselines"
        },
        "profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Id"
        }
      },
      "title": "Scan",
      "type": "object"
    },
    "stage": {
      "additionalProperties": false,
      "properties": {
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        }
      },
      "required": [
        "scan_id"
      ],
      "title": "Stage",
      "type": "object"
    },
    "decision": {
      "additionalProperties": false,
      "properties": {
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "choice": {
          "minLength": 1,
          "title": "Choice",
          "type": "string"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "obligation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obligation Id"
        },
        "definition_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition Id"
        }
      },
      "required": [
        "scan_id",
        "choice",
        "reason"
      ],
      "title": "Decision",
      "type": "object"
    },
    "validate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id"
      ],
      "title": "Validate",
      "type": "object"
    },
    "export": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "kind": {
          "default": "experimental_bundle",
          "enum": [
            "experimental_bundle",
            "validated_managed_release"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "candidate_id"
      ],
      "title": "Export",
      "type": "object"
    },
    "rollback": {
      "additionalProperties": false,
      "properties": {
        "release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Id"
        },
        "preview": {
          "default": true,
          "title": "Preview",
          "type": "boolean"
        }
      },
      "title": "Rollback",
      "type": "object"
    },
    "investigate": {
      "additionalProperties": false,
      "properties": {
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "mode": {
          "default": "replay",
          "enum": [
            "replay",
            "live"
          ],
          "title": "Mode",
          "type": "string"
        },
        "replay": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 100,
          "title": "Replay",
          "type": "array"
        }
      },
      "required": [
        "scan_id"
      ],
      "title": "Investigate",
      "type": "object"
    },
    "cancel": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "title": "Cancel",
      "type": "object"
    },
    "backup": {
      "additionalProperties": false,
      "properties": {},
      "title": "Backup",
      "type": "object"
    },
    "runtime_probe": {
      "additionalProperties": false,
      "properties": {
        "recipe": {
          "additionalProperties": true,
          "title": "Recipe",
          "type": "object"
        }
      },
      "title": "RuntimeProbe",
      "type": "object"
    },
    "configure_inference": {
      "$defs": {
        "InvestigationBudgets": {
          "additionalProperties": false,
          "properties": {
            "max_calls": {
              "default": 8,
              "maximum": 32,
              "minimum": 1,
              "title": "Max Calls",
              "type": "integer"
            },
            "max_tool_calls": {
              "default": 24,
              "maximum": 256,
              "minimum": 0,
              "title": "Max Tool Calls",
              "type": "integer"
            },
            "max_source_bytes": {
              "default": 131072,
              "maximum": 1048576,
              "minimum": 1024,
              "title": "Max Source Bytes",
              "type": "integer"
            },
            "max_tokens": {
              "default": 64000,
              "maximum": 262144,
              "minimum": 1024,
              "title": "Max Tokens",
              "type": "integer"
            },
            "max_seconds": {
              "default": 120,
              "maximum": 600,
              "minimum": 1,
              "title": "Max Seconds",
              "type": "integer"
            }
          },
          "title": "InvestigationBudgets",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "model": {
          "default": "",
          "maxLength": 200,
          "title": "Model",
          "type": "string"
        },
        "allowed_providers": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Allowed Providers",
          "type": "array"
        },
        "excluded_patterns": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Excluded Patterns",
          "type": "array"
        },
        "budgets": {
          "$ref": "#/$defs/InvestigationBudgets"
        },
        "tools_supported": {
          "default": false,
          "title": "Tools Supported",
          "type": "boolean"
        },
        "source_policy_confirmed": {
          "default": false,
          "title": "Source Policy Confirmed",
          "type": "boolean"
        },
        "provider_policy_confirmed": {
          "default": false,
          "title": "Provider Policy Confirmed",
          "type": "boolean"
        }
      },
      "title": "InferencePolicy",
      "type": "object"
    }
  }
}
