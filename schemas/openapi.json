  "components": {
    "schemas": {
      "AgentRequest": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "status",
              "release",
              "session",
              "issues",
              "inspect",
              "proposal",
              "challenge",
              "answer",
              "apply",
              "test",
              "enable",
              "undo",
              "context",
              "check",
              "remember",
              "capabilities",
              "search_knowledge",
              "read_knowledge",
              "search_sources",
              "read_source",
              "related_definitions",
              "brief",
              "missing_mods",
              "read_sources",
              "concerns",
              "concern_evidence",
              "record_review",
              "investigation_report",
              "missing_candidates",
              "inspect_candidate",
              "version_preference"
            ],
            "title": "Operation"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation"
        ],
        "title": "AgentRequest"
      },
      "Command": {
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "create_workspace",
              "discover_ck3",
              "import_ck3",
              "scan",
              "stage",
              "decision",
              "validate",
              "export",
              "rollback",
              "investigate",
              "cancel",
              "backup",
              "runtime_probe",
              "configure_inference",
              "agent_index",
              "agent_prepare",
              "agent_apply",
              "agent_test",
              "agent_undo",
              "agent_check"
            ],
            "title": "Command"
          },
          "workspace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workspace Id"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Idempotency Key"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "command",
          "idempotency_key"
        ],
        "title": "Command"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
